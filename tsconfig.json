{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "playwright.books.config.ts",
    "playwright.reader.config.ts"
  ]
}
